---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { client } from '../config/client';
import { withBase } from '../lib/url';
import { waLink, genericMessages } from '../lib/wa';
---

<Base title={`Страница не найдена — ${client.brandName}`} description="Страница не найдена">
  <main id="main" class="shell flex min-h-svh flex-col justify-center py-16">
    <div class="mx-auto w-full max-w-[46ch]">
      <Logo class="h-9 w-9" />
      <p class="stamp mt-6">Ошибка 404</p>
      <h1 class="mt-3 text-[length:var(--fs-h2)]">Такой позиции в наряде нет</h1>
      <p class="mt-4 text-[1.0625rem] leading-relaxed text-[var(--color-ink-mute)]">
        Страница не найдена или была перенесена. Вернитесь на главную — там услуги, цены, квиз и
        калькулятор.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={withBase('')} class="btn btn-primary">На главную</a>
        <a
          href={waLink(genericMessages.footer)}
          target="_blank"
          rel="noopener"
          class="btn btn-ghost"
        >
          Написать в WhatsApp
        </a>
      </div>
    </div>
  </main>
</Base>
