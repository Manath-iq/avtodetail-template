---
import { client } from '../config/client';
import { waLink, genericMessages } from '../lib/wa';
import { withBase } from '../lib/url';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="on-dark border-t border-white/10 py-12">
  <div class="shell">
    <div class="grid12 gap-y-8">
      <div class="col-span-4 md:col-span-8 lg:col-span-5">
        <div class="flex items-center gap-2.5">
          <Logo tone="light" class="h-8 w-8" />
          <span class="font-[var(--font-display)] text-[1rem] font-semibold tracking-tight text-white">
            {client.brandName}
          </span>
        </div>
        <p class="mt-4 max-w-[38ch] text-[0.9rem] leading-relaxed text-white/50">
          {client.tagline} в {client.cityIn}. Диагностика, ремонт, шиномонтаж, детейлинг и защитные
          покрытия по заказ-наряду.
        </p>
      </div>

      <div class="col-span-4 md:col-span-4 lg:col-span-3">
        <p class="stamp">Контакты</p>
        <ul class="mt-3 flex flex-col gap-2 text-[0.9rem] text-white/70">
          <li>
            <a href={`tel:${client.phoneHref}`}
          data-goal="phone_click" class="data tap inline-flex items-center">
              {client.phone}
            </a>
          </li>
          <li>
            <a href={`mailto:${client.email}`} class="tap inline-flex items-center">{client.email}</a>
          </li>
          <li>
            <a
              href={waLink(genericMessages.footer)}
              target="_blank"
              rel="noopener"
              data-goal="footer_whatsapp_click"
              class="tap inline-flex items-center text-[var(--color-service)]"
            >
              Написать в WhatsApp
            </a>
          </li>
        </ul>
      </div>

      <div class="col-span-4 md:col-span-4 lg:col-span-4">
        <p class="stamp">Адрес и режим</p>
        <p class="mt-3 text-[0.9rem] leading-relaxed text-white/70">{client.address}</p>
        <p class="data mt-2 text-[0.85rem] text-white/50">{client.workHours}</p>
        <a
          href={client.mapUrl}
          target="_blank"
          rel="noopener"
          data-goal="map_open"
          class="tap mt-3 inline-flex items-center gap-1.5 text-[0.875rem] text-[var(--color-service)] underline decoration-dotted underline-offset-4"
        >
          Открыть маршрут
        </a>
      </div>
    </div>

    <hr class="rule-dashed my-8" />

    <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
      <div class="flex flex-col gap-2">
        <p class="data text-[0.8rem] leading-relaxed text-white/45">
          {client.legalName} • ОГРНИП {client.ogrn} • ИНН {client.inn}
        </p>
        <p class="data text-[0.8rem] text-white/45">{client.address} • {client.phone}</p>
      </div>

      <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Юридические документы">
        <a
          href={withBase('privacy/')}
          class="tap inline-flex items-center text-[0.85rem] text-white/60 underline decoration-dotted underline-offset-4"
        >
          Политика обработки персональных данных
        </a>
        <a
          href={withBase('consent/')}
          class="tap inline-flex items-center text-[0.85rem] text-white/60 underline decoration-dotted underline-offset-4"
        >
          Согласие на обработку персональных данных
        </a>
      </nav>
    </div>

    <p class="legal-note mt-6 max-w-[70ch]">
      Информация на сайте носит информационный характер и не является публичной офертой. Стоимость
      работ уточняется после осмотра автомобиля и фиксируется в заказ-наряде. © {year}
      {client.legalName}.
    </p>
  </div>
</footer>
