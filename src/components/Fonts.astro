---
import { withBase } from '../lib/url';

/**
 * Шрифты self-host (секция 8).
 * Подключены только реально нужные подмножества, поэтому @font-face
 * держим инлайном в <head> — это дешевле лишнего запроса за CSS.
 *
 * Display (Unbounded) и Body (Onest) — preload.
 * Data (JetBrains Mono) без preload: подтягивается по факту появления цифр
 * в калькуляторе и прайсе.
 */
const f = (name: string) => withBase(`fonts/${name}.woff2`);

const RANGE = {
  cyrillic: 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116',
  latin:
    'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD',
  latinExt:
    'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF',
};
---

<link rel="preload" as="font" type="font/woff2" href={f('unbounded-cyrillic')} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={f('onest-cyrillic')} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={f('onest-latin')} crossorigin />

<style
  is:inline
  set:html={`
@font-face{font-family:'Unbounded Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${f('unbounded-cyrillic')}) format('woff2-variations');unicode-range:${RANGE.cyrillic}}
@font-face{font-family:'Unbounded Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${f('unbounded-latin')}) format('woff2-variations');unicode-range:${RANGE.latin}}
@font-face{font-family:'Onest Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${f('onest-cyrillic')}) format('woff2-variations');unicode-range:${RANGE.cyrillic}}
@font-face{font-family:'Onest Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${f('onest-latin')}) format('woff2-variations');unicode-range:${RANGE.latin}}
@font-face{font-family:'Onest Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${f('onest-latin-ext')}) format('woff2-variations');unicode-range:${RANGE.latinExt}}
@font-face{font-family:'JetBrains Mono Variable';font-style:normal;font-display:swap;font-weight:100 800;src:url(${f('jetbrains-mono-cyrillic')}) format('woff2-variations');unicode-range:${RANGE.cyrillic}}
@font-face{font-family:'JetBrains Mono Variable';font-style:normal;font-display:swap;font-weight:100 800;src:url(${f('jetbrains-mono-latin')}) format('woff2-variations');unicode-range:${RANGE.latin}}
@font-face{font-family:'JetBrains Mono Variable';font-style:normal;font-display:swap;font-weight:100 800;src:url(${f('jetbrains-mono-latin-ext')}) format('woff2-variations');unicode-range:${RANGE.latinExt}}
`}
/>
