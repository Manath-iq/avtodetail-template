---
import { faq } from '../content/faq';
import { waLink, genericMessages } from '../lib/wa';
import SectionHead from './SectionHead.astro';
---

<section id="faq" class="section">
  <div class="shell grid12 items-start gap-y-8">
    <div class="col-span-4 md:col-span-8 lg:col-span-4">
      <SectionHead no="13" label="Вопросы" title="Что обычно спрашивают до записи" />

      <div class="mt-6 flex flex-col gap-3" data-anim>
        <a href="#quiz" class="btn btn-ghost w-full sm:w-auto lg:w-full">Пройти квиз</a>
        <a
          href={waLink(genericMessages.footer)}
          target="_blank"
          rel="noopener"
          data-goal="faq_whatsapp_click"
          class="btn btn-primary w-full sm:w-auto lg:w-full"
        >
          Спросить в WhatsApp
        </a>
      </div>
    </div>

    <div class="col-span-4 md:col-span-8 lg:col-span-8">
      <ul class="flex flex-col">
        {
          faq.map((item, i) => (
            <li data-anim style={`--anim-delay:${Math.min(i, 5) * 0.04}s`}>
              <details class="faq-item group border-t border-dashed border-[var(--color-line)]">
                <summary class="tap flex cursor-pointer list-none items-start gap-4 py-4 [&::-webkit-details-marker]:hidden">
                  <span class="data mt-1 shrink-0 text-[0.8rem] text-[var(--color-ink-faint)]">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="flex-1 font-[var(--font-display)] text-[1.0625rem] font-semibold leading-snug tracking-tight">
                    {item.q}
                  </span>
                  <svg
                    class="mt-1.5 shrink-0 text-[var(--color-ink-faint)] transition-transform duration-300 group-open:rotate-45"
                    width="18"
                    height="18"
                    viewBox="0 0 18 18"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    aria-hidden="true"
                  >
                    <path d="M9 3.5v11M3.5 9h11" />
                  </svg>
                </summary>

                <div class="faq-body">
                  <p class="pb-5 pl-[2.4rem] pr-8 text-[0.9375rem] leading-relaxed text-[var(--color-ink-mute)]">
                    {item.a}
                  </p>
                </div>
              </details>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* Раскрытие без скачка высоты (спецификация, блок 13). */
  .faq-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.34s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .faq-body > * {
    overflow: hidden;
  }
  .faq-item[open] .faq-body {
    grid-template-rows: 1fr;
  }
  @supports not (grid-template-rows: 0fr) {
    .faq-body {
      display: block;
    }
  }
</style>

<script>
  // details не анимируется при закрытии — придерживаем закрытие до конца перехода.
  document.querySelectorAll<HTMLDetailsElement>('.faq-item').forEach((el) => {
    const summary = el.querySelector('summary');
    if (!summary) return;
    summary.addEventListener('click', (e) => {
      if (!el.open) return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      e.preventDefault();
      const body = el.querySelector<HTMLElement>('.faq-body');
      if (!body) {
        el.open = false;
        return;
      }
      body.style.gridTemplateRows = '0fr';
      const done = () => {
        el.open = false;
        body.style.gridTemplateRows = '';
        body.removeEventListener('transitionend', done);
      };
      body.addEventListener('transitionend', done);
    });
  });
</script>
