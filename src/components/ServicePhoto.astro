---
import { Picture } from 'astro:assets';
import lift from '../assets/photos/svc-lift.webp';
import scanner from '../assets/photos/svc-scanner.webp';
import polisher from '../assets/photos/svc-polisher.webp';
import extractor from '../assets/photos/svc-extractor.webp';
import service from '../assets/photos/svc-service.webp';
import electrics from '../assets/photos/svc-electrics.webp';
import tires from '../assets/photos/svc-tires.webp';
import ceramic from '../assets/photos/svc-ceramic.webp';

/**
 * Демо-фото категорий услуг: свой кадр на каждую карточку.
 *
 * Раньше четыре мотива делились на восемь карточек, и в одном ряду сетки
 * оказывались две-три одинаковые картинки — сайт читался как шаблон.
 *
 * Ассеты обезличенные — без людей, брендов, текста и номеров (раздел 6).
 * Под реального клиента файлы в src/assets/photos заменяются на снимки
 * из шот-листа с теми же именами, разметку трогать не нужно.
 */
interface Props {
  kind: 'lift' | 'scanner' | 'polisher' | 'extractor' | 'service' | 'electrics' | 'tires' | 'ceramic';
  class?: string;
  /** Первый экран не lazy, остальное — lazy (раздел 8, «Медиа»). */
  eager?: boolean;
}
const { kind, class: klass = '', eager = false } = Astro.props;

const sources = { lift, scanner, polisher, extractor, service, electrics, tires, ceramic };
const alts: Record<Props['kind'], string> = {
  lift: 'Автомобиль на двухстоечном подъёмнике в ремзоне сервиса',
  scanner: 'Диагностический сканер на тележке у открытой двери автомобиля',
  polisher: 'Полировальная машинка на кузове под лампой контроля ЛКП',
  extractor: 'Экстрактор и парогенератор при химчистке салона автомобиля',
  service: 'Масляный фильтр, канистра масла и сливной поддон на верстаке',
  electrics: 'Открытый блок предохранителей и щупы мультиметра на клемме',
  tires: 'Колесо на шиномонтажном станке, балансировочный стенд позади',
  ceramic: 'Аппликатор и флакон защитного состава на полированном кузове',
};
---

<Picture
  src={sources[kind]}
  alt={alts[kind]}
  formats={['avif']}
  fallbackFormat="webp"
  widths={[320, 640, 960]}
  sizes="(min-width: 1100px) 320px, (min-width: 640px) 45vw, 92vw"
  loading={eager ? 'eager' : 'lazy'}
  decoding={eager ? 'sync' : 'async'}
  class:list={['h-full w-full object-cover', klass]}
/>
