---
import { client } from '../config/client';
import { waLink, genericMessages } from '../lib/wa';
import Wa from './icons/Wa.astro';
import Phone from './icons/Phone.astro';
---

<!-- Быстрое действие на мобильном: WhatsApp как основной путь (спецификация, п.1) -->
<div
  id="mobile-bar"
  class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-[var(--color-line)] bg-[color-mix(in_srgb,var(--color-paper)_94%,transparent)] backdrop-blur-md transition-transform duration-300 md:hidden"
  style="padding-bottom:var(--safe-b)"
  data-mobile-bar
>
  <div class="flex gap-2 px-3 py-2.5">
    <a href={`tel:${client.phoneHref}`}
          data-goal="phone_click" class="btn btn-ghost !min-h-12 flex-1 !text-[0.875rem]">
      <Phone size={17} />
      Позвонить
    </a>
    <a
      href={waLink(genericMessages.hero)}
      target="_blank"
      rel="noopener"
      data-goal="mobile_whatsapp_click"
      class="btn btn-primary !min-h-12 flex-[1.3] !text-[0.875rem]"
    >
      <Wa size={17} />
      Написать
    </a>
  </div>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-mobile-bar]');
  const final = document.querySelector('#final');
  if (bar) {
    let ticking = false;
    const apply = () => {
      const past = window.scrollY > window.innerHeight * 0.7;
      // Прячем над финальным CTA — там кнопки уже есть.
      const atFinal = final ? final.getBoundingClientRect().top < window.innerHeight * 0.8 : false;
      bar.classList.toggle('translate-y-full', !past || atFinal);
      ticking = false;
    };
    addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(apply);
        }
      },
      { passive: true },
    );
    apply();
  }
</script>
