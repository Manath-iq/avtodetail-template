---
/**
 * Демо-ассеты вместо фото (секция 6, «Что использовать в демо вместо реальных фото»):
 * обезличенная техническая графика без брендов, людей и номеров.
 * При подключении реального клиента этот компонент заменяется на <Image>
 * с фото из шот-листа — разметка карточки не меняется.
 */
interface Props {
  kind: 'lift' | 'scanner' | 'polisher' | 'extractor';
  class?: string;
}
const { kind, class: klass = '' } = Astro.props;

const accent: Record<Props['kind'], string> = {
  lift: '#8B5E3C',
  scanner: '#4DA3A6',
  polisher: '#F2C14E',
  extractor: '#4DA3A6',
};
const a = accent[kind];
---

<div
  class:list={['relative overflow-hidden bg-[var(--color-graphite)]', klass]}
  aria-hidden="true"
>
  <div class="paper-grid-dark absolute inset-0"></div>

  <svg class="relative h-full w-full" viewBox="0 0 320 200" fill="none" preserveAspectRatio="xMidYMid slice">
    {
      kind === 'lift' && (
        <g stroke="#ffffff" stroke-opacity="0.34" stroke-width="1.6" stroke-linecap="round">
          <path d="M40 168h240" stroke-opacity="0.2" />
          <path d="M92 168V96M228 168V96" />
          <path d="M78 96h28M214 96h28" />
          <path d="M78 112h164" stroke={a} stroke-opacity="0.95" stroke-width="2.4" />
          <path d="M104 112V84a26 26 0 0 1 26-26h60a26 26 0 0 1 26 26v28" />
          <circle cx="126" cy="122" r="11" />
          <circle cx="196" cy="122" r="11" />
          <path d="M120 58h80" stroke-opacity="0.18" />
          <path d="M52 168V40M268 168V40" stroke-opacity="0.14" />
        </g>
      )
    }
    {
      kind === 'scanner' && (
        <g stroke="#ffffff" stroke-opacity="0.34" stroke-width="1.6" stroke-linecap="round">
          <rect x="108" y="42" width="104" height="132" rx="14" />
          <rect x="122" y="58" width="76" height="60" rx="6" stroke={a} stroke-opacity="0.95" />
          <path d="M132 78h34M132 90h50M132 102h24" stroke={a} stroke-opacity="0.7" stroke-width="2" />
          <circle cx="141" cy="140" r="8" />
          <circle cx="160" cy="140" r="8" />
          <circle cx="179" cy="140" r="8" />
          <path d="M160 42V22h64a18 18 0 0 1 18 18v40" stroke-opacity="0.22" />
          <path d="M242 80a10 10 0 1 0 0 20 10 10 0 0 0 0-20Z" stroke-opacity="0.22" />
          <path d="M40 60h48M40 74h30M40 120h40" stroke-opacity="0.12" />
        </g>
      )
    }
    {
      kind === 'polisher' && (
        <g stroke="#ffffff" stroke-opacity="0.34" stroke-width="1.6" stroke-linecap="round">
          <circle cx="150" cy="118" r="48" />
          <circle cx="150" cy="118" r="32" stroke={a} stroke-opacity="0.95" stroke-width="2.4" />
          <circle cx="150" cy="118" r="14" stroke-opacity="0.22" />
          <path d="M150 70V44a14 14 0 0 1 14-14h56" />
          <rect x="220" y="18" width="68" height="26" rx="13" />
          <path d="M40 176h240" stroke-opacity="0.18" />
          <path d="M62 176v-28h34v28" stroke-opacity="0.16" />
          <path d="M110 30h-46" stroke-opacity="0.12" />
        </g>
      )
    }
    {
      kind === 'extractor' && (
        <g stroke="#ffffff" stroke-opacity="0.34" stroke-width="1.6" stroke-linecap="round">
          <rect x="52" y="86" width="86" height="88" rx="12" />
          <path d="M60 108h70" stroke={a} stroke-opacity="0.95" stroke-width="2.4" />
          <circle cx="95" cy="142" r="16" stroke-opacity="0.24" />
          <path d="M138 112c44 0 44-52 88-52" />
          <path d="M226 46a14 14 0 1 1 0 28 14 14 0 0 1 0-28Z" stroke={a} stroke-opacity="0.8" />
          <path d="M170 174h110" stroke-opacity="0.18" />
          <path d="M196 174v-34h58v34" stroke-opacity="0.16" />
          <path d="M40 60h40" stroke-opacity="0.12" />
        </g>
      )
    }
  </svg>
</div>
