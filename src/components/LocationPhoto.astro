---
import { Picture } from 'astro:assets';
import exterior from '../assets/photos/loc-exterior.webp';
import { client } from '../config/client';

/**
 * Кадр «это реальное место» для блока 8.
 * Демо-ассет: без людей, вывесок, номеров домов и госномеров (раздел 6).
 * Под клиента заменяется фото фасада из шот-листа с тем же именем файла.
 */
---

<Picture
  src={exterior}
  alt={`Вход и парковка автосервиса: ${client.address}`}
  formats={['avif']}
  fallbackFormat="webp"
  widths={[480, 800, 1200]}
  sizes="(min-width: 1100px) 700px, 94vw"
  loading="lazy"
  decoding="async"
  class="h-full w-full object-cover"
/>
