---
interface Props {
  class?: string;
  tone?: 'dark' | 'light';
}
const { class: klass = '', tone = 'dark' } = Astro.props;
const ink = tone === 'dark' ? '#111418' : '#ffffff';
---

<svg
  class={klass}
  width="36"
  height="36"
  viewBox="0 0 36 36"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <rect x="0.75" y="0.75" width="34.5" height="34.5" rx="10" stroke={ink} stroke-opacity="0.28" stroke-width="1.5"></rect>
  <path d="M9 11.5h13.5" stroke={ink} stroke-width="2" stroke-linecap="round"></path>
  <path d="M9 17.5h18" stroke={ink} stroke-width="2" stroke-linecap="round" stroke-opacity="0.45"></path>
  <path d="M9 23.5h9" stroke={ink} stroke-width="2" stroke-linecap="round" stroke-opacity="0.45"></path>
  <circle cx="25.5" cy="24" r="4" fill="#D94A3A"></circle>
</svg>
