---
import { services } from '../config/services';
import { waLink, genericMessages } from '../lib/wa';
import { formatPrice } from '../lib/calc';
import SectionHead from './SectionHead.astro';
import ServicePhoto from './ServicePhoto.astro';
---

<section id="services" class="section">
  <div class="shell">
    <SectionHead
      no="04"
      label="Категории работ"
      title="Восемь направлений — от поиска ошибки до защиты кузова"
      lead="Каждая карточка раскрывается как вкладка в заказ-наряде: что входит, сколько это занимает и от какой суммы начинается расчёт."
    />

    <p class="stamp mt-6 flex items-center gap-2 sm:hidden" data-anim>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <path d="M1.5 7h11M9 3.5 12.5 7 9 10.5"></path>
      </svg>
      Листайте вбок — 8 направлений
    </p>

    <!-- Мобильный: горизонтальная лента, чтобы восемь карточек не растягивали экран.
         От sm и выше — обычная сетка. -->
    <ul class="services-rail scroll-x -mx-[var(--shell-pad)] mt-4 flex items-start gap-4 px-[var(--shell-pad)] pb-4 sm:mt-10 sm:mx-0 sm:grid sm:snap-none sm:grid-cols-2 sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-4">
      {
        services.map((s, i) => (
          <li
            class="w-[76vw] max-w-[20rem] shrink-0 snap-start sm:w-auto sm:max-w-none"
            data-anim
            style={`--anim-delay:${(i % 4) * 0.06}s`}
          >
            <details class="card card-lift group h-full overflow-hidden" name="service">
              <summary
                class="tap flex cursor-pointer list-none flex-col [&::-webkit-details-marker]:hidden"
                aria-label={`${s.title} — подробнее`}
              >
                <span class="relative block aspect-[16/10] w-full overflow-hidden bg-[var(--color-graphite)]">
                  <ServicePhoto kind={s.visual} />
                  <span
                    class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_top,rgba(17,20,24,0.55),transparent_55%)]"
                    aria-hidden="true"
                  />
                </span>

                <span class="flex w-full flex-col gap-2 p-5">
                  <span class="flex items-start justify-between gap-3">
                    <span class="font-[var(--font-display)] text-[1.0625rem] font-semibold leading-tight tracking-tight">
                      {s.title}
                    </span>
                    <svg
                      class="mt-0.5 shrink-0 text-[var(--color-ink-faint)] transition-transform duration-300 group-open:rotate-45"
                      width="18"
                      height="18"
                      viewBox="0 0 18 18"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      aria-hidden="true"
                    >
                      <path d="M9 3.5v11M3.5 9h11" />
                    </svg>
                  </span>

                  <span class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    {s.fromPrice && (
                      <span class="data text-[0.95rem] font-semibold">
                        от {formatPrice(s.fromPrice)} ₽
                      </span>
                    )}
                    {s.durationHint && (
                      <span class="stamp !normal-case !tracking-normal">{s.durationHint}</span>
                    )}
                  </span>
                </span>
              </summary>

              <div class="border-t border-dashed border-[var(--color-line)] px-5 py-4">
                <p class="text-[0.9375rem] leading-relaxed text-[var(--color-ink-mute)]">
                  {s.description}
                </p>
                <a
                  href={waLink(genericMessages.service(s.title))}
                  target="_blank"
                  rel="noopener"
                  data-goal="service_whatsapp_click"
                  class="tap mt-3 inline-flex items-center gap-1.5 text-[0.875rem] font-medium text-[var(--color-brake)] underline decoration-dotted underline-offset-4"
                >
                  Подобрать услугу
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                    <path d="M3 7h8M7.5 3.5 11 7l-3.5 3.5" />
                  </svg>
                </a>
              </div>
            </details>
          </li>
        ))
      }
    </ul>

    <p class="legal-note mt-6" data-anim>
      Информация о стоимости носит информационный характер и может быть уточнена после осмотра
      автомобиля.
    </p>
  </div>
</section>
